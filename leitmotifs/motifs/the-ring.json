{
 "format": 1,
 "motif": {
  "id": "the-ring",
  "name": "The Ring",
  "description": "Passages of the piano score that match one melody, in levels by how close they are to it. Level 1 is the closest. A run of repeated notes counts as one note. Passages that overlap, or lie within 1 measure of each other, are joined into one; the level is that of the closest.",
  "source": {
   "author": "J. K. Holman",
   "title": "Wagner's Ring: A Listener's Companion & Concordance",
   "publication": "Portland, Oregon: Amadeus Press, 1996; paperback 2003, ISBN 978-1-57467-070-7"
  }
 },
 "levels": [
  {
   "level": 0,
   "label": "Original",
   "name": "The melody as given",
   "description": "The melody as you gave it. It is not a passage of the score."
  },
  {
   "level": 1,
   "name": "Closest to the original",
   "description": "The best partial matches of the whole phrase. The pitches and the rhythm are the same, in any octave."
  },
  {
   "level": 2,
   "name": "Same core pitches",
   "description": "Notes 1 to 8 of the phrase have the same pitches, in any octave, but the rhythm differs. In a sung passage the score may have one short extra note between two of them: it is skipped."
  }
 ],
